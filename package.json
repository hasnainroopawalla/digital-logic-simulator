{
  "name": "digital-logic-sim",
  "version": "1.6.1",
  "homepage": "https://hasnainroopawalla.github.io/digital-logic-simulator",
  "description": "Interactive digital logic circuit simulator built with React and WebGPU. Build logic gates, connect circuits, create custom chips, and simulate digital logic in your browser.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@digital-logic-sim/web --",
    "start": "npm run dev --",
    "preview": "npm run preview --workspace=@digital-logic-sim/web --",
    "build": "npm run build --workspace=@digital-logic-sim/web -- --emptyOutDir",
    "test:unit": "npm test",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.json",
    "lint": "biome check",
    "lint:fix": "biome check --fix . && biome format --write ."
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.2.5",
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
